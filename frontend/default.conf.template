server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Version de nginx masquée ; en-têtes de sécurité sur toutes les réponses (OWASP A05). La politique de contenu
    # n'admet que les ressources de l'application elle-même : aucun script tiers, aucun script en ligne.
    server_tokens off;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    # HSTS : la plateforme n'est servie qu'en HTTPS derrière le répartiteur (Azure Front Door, ingress).
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # SPA : toutes les routes non-fichier renvoient index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Assistant IA (Ollama) : génération LLM potentiellement longue (CPU) — délai étendu
    # pour éviter un 504 pendant la rédaction. Préfixe plus spécifique que /api/.
    location /api/ia/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Proxy vers le backend Spring Boot. BACKEND_URL est substitué au démarrage
    # (envsubst du template) : http://backend:8080 en Docker Compose,
    # l'URL du Container App backend sur Azure.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Provisionnement SCIM 2.0 (Saviynt, Entra ID) : jeton porteur vérifié par le backend
    location /scim/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SSO OIDC (Entra ID) et documentation OpenAPI / Swagger, servis par le backend
    location /oauth2/       { proxy_pass ${BACKEND_URL}; }
    location /login/oauth2/ { proxy_pass ${BACKEND_URL}; }
    location /swagger-ui/   { proxy_pass ${BACKEND_URL}; }
    location /v3/           { proxy_pass ${BACKEND_URL}; }

    # Cache des assets statiques
    location /assets/ {
        expires 1y;
        # Un add_header dans un bloc location remplace ceux du serveur : on les répète ici.
        add_header Cache-Control "public, immutable";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }
}

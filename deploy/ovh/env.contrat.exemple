# Modèle de deploy/ovh/.env.contrat — écrit sur le serveur par preparer-serveur.sh (mode 600, jamais versionné).
DB_PASSWORD=
JWT_SECRET=
# Chiffrent les secrets M365 stockés en base : à reprendre de l'installation précédente, jamais à régénérer.
APP_CRYPTO_KEY=
APP_CRYPTO_SALT=
# Adresse publique du portail de signature : liens des invitations et de « Signer maintenant ». Sans elle, les liens
# pointeraient vers localhost.
CLM_PORTAIL_URL=https://contrat.vinaitsolution.com/portail
APP_CORS_ALLOWED_ORIGINS=https://contrat.vinaitsolution.com,https://*.contrat.vinaitsolution.com
OLLAMA_BASE_URL=http://vina_ollama:11434
OLLAMA_MODEL=llama3.1
PUBLICATION_DOSSIER_DEFAUT=Contrats
PUBLICATION_SIMULATEUR_REPERTOIRE=/app/data/simulateur
LOG_APP_LEVEL=INFO
# Démonstration publique : organisations des appels d'offres et comptes de data/tenants-demo.json.
APP_TENANTS_DEMO=true
# Facultatif — antivirus ClamAV (ADR-027) et défi anti-robot réel (ADR-026) ; défaut : signatures et simulation.
# ANTIVIRUS_MODE=clamav
# ANTIVIRUS_CLAMAV_HOTE=
# CAPTCHA_MODE=siteverify
# CAPTCHA_FOURNISSEUR=TURNSTILE
# CAPTCHA_CLE_SITE=
# CAPTCHA_SECRET=

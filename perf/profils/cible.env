# Profil « cible » — TI-12 (IQ, AO 2026-6370-0005) : 500 utilisateurs concurrents sur l'infrastructure cible.
# Lu par run.sh (PROFIL=cible). Chaque valeur ne s'applique que si la variable n'est pas déjà fournie : l'hôte, les
# comptes et l'autorisation viennent toujours de l'appelant (voir README « Profil cible »), jamais de ce fichier.

: "${PLAN:=clm-trousses-load.jmx}"
: "${THREADS:=500}"
# Montée progressive : 500 connexions en 300 s (≈ 1,7 par seconde), puis palier soutenu de 600 s à 500 utilisateurs
# actifs : la durée borne l'essai (DUREE, montée comprise), les boucles tournent sans fin jusque-là. Un nombre fixe de
# boucles ne garantit pas le palier : avec 3 boucles d'environ 16 s, les premiers fils finissaient avant que les derniers
# ne démarrent, et l'essai ne comptait jamais plus d'une centaine d'utilisateurs actifs à la fois.
: "${RAMPUP:=300}"
: "${DUREE:=900}"
: "${LOOPS:=-1}"
# Un employé ouvre une session puis enchaîne ses gestes : une connexion par utilisateur virtuel, pas une par boucle.
: "${CONNEXION_CHAQUE_BOUCLE:=false}"
# Un utilisateur réel marque une pause entre deux gestes : sans elle, 500 fils mesurent une rafale, pas un usage.
: "${PAUSE_MS:=2000}"
: "${BASE_PROTOCOL:=https}"
: "${BASE_PORT:=443}"
# Comptes d'essai propres à la cible (email,motDePasse ; un par utilisateur virtuel), jamais versionnés.
: "${COMPTES:=data/cible/comptes.csv}"
: "${RESULTATS:=results-cible}"

# Hôte obligatoire : aucune valeur par défaut, pour qu'un essai ne parte jamais vers un environnement implicite.
[ -n "${BASE_HOST:-}" ] || { echo "✗ Profil cible : BASE_HOST est obligatoire (hôte de l'infrastructure cible)." >&2; exit 2; }
[ -s "$COMPTES" ] || { echo "✗ Profil cible : fichier de comptes absent ($COMPTES, en-tête email,motDePasse)." >&2; exit 2; }

# Copier en terraform.tfvars et adapter. Ne pas committer (secrets/état).
project     = "vina-contrat"
environment = "prod"
location    = "canadacentral"
# Hébergement au Québec (ADR-020, option B) : location = "canadaeast" et zones = [] (région sans zones de disponibilité).
# zones     = ["1", "2", "3"]

kubernetes_version = "1.30"
aks_node_size      = "Standard_D4s_v5"
aks_node_min       = 3
aks_node_max       = 9

postgres_version    = "16"
postgres_sku        = "GP_Standard_D4s_v3"
postgres_storage_mb = 131072

app_hostname          = "contrat.vinaitsolution.com"
availability_test_url = "https://contrat.vinaitsolution.com/api/health"

# Reprise inter-régions (SEC-11, ADR-039). Hébergement au Québec (option B) : dr_location = "canadacentral".
dr_location                          = "canadaeast"
dr_strategie_base                    = "replique"    # ou "geo_restauration" (RPO jusqu'à 1 h, sans réplique)
dr_calcul                            = "pilot_light" # ou "veille_active" / "aucun"
dr_postgres_sku                      = "GP_Standard_D4s_v3"
postgres_backup_retention_days       = 35
stockage_retention_suppression_jours = 30
stockage_immutabilite_jours          = 0
origine_primaire_hote                = "ingress-cc.contrat.vinaitsolution.com"
origine_secours_hote                 = "ingress-ce.contrat.vinaitsolution.com"
alert_email           = "faliherizo@vinaitsolution.com"

# Adresses (CIDR) d'administration seules admises sur l'API du plan de contrôle et le coffre de secrets (obligatoire).
ip_administration = ["203.0.113.10/32"]

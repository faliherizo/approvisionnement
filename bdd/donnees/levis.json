    "lev.revision.circuit": {
      "description": "Révision par plusieurs intervenants : commentaire ancré, résolution, circuit hiérarchisé APPRO → JURIDIQUE → DIRECTION",
      "etapes": [
        {
          "appel": "POST /api/documents",
          "corps": {
            "titre": "Devis BDD ${unique}",
            "type": "APPEL_OFFRES_PUBLIC",
            "modeSollicitation": "APPEL_OFFRES_PUBLIC",
            "valeurEstimee": 150000,
            "contexte": "travaux"
          },
          "capturer": {
            "document": "$.id"
          }
        },
        {
          "appel": "POST /api/documents/${document}/assembler",
          "corps": {
            "clauseIds": []
          },
          "capturer": {
            "clauseDoc": "$.clauses[0].clauseId"
          }
        },
        {
          "appel": "POST /api/documents/${document}/commentaires",
          "profil": "juriste de Lévis",
          "corps": {
            "corps": "Préciser le délai de garantie.",
            "clauseId": "${clauseDoc}"
          },
          "capturer": {
            "commentaire": "$.id"
          },
          "verifier": [
            {
              "chemin": "$.resolu",
              "egal": false
            }
          ]
        },
        {
          "appel": "POST /api/documents/${document}/commentaires/${commentaire}/resolution",
          "corps": {
            "resolu": true
          },
          "verifier": [
            {
              "chemin": "$.resolu",
              "egal": true
            }
          ]
        },
        {
          "appel": "POST /api/documents/${document}/approbation",
          "verifier": [
            {
              "chemin": "$[*].roleRequis",
              "inclut": "APPRO"
            },
            {
              "chemin": "$[*].roleRequis",
              "inclut": "JURIDIQUE"
            },
            {
              "chemin": "$[*].roleRequis",
              "inclut": "DIRECTION"
            }
          ],
          "capturer": {
            "n1": "$[0].id",
            "n2": "$[1].id",
            "n3": "$[2].id"
          }
        },
        {
          "appel": "POST /api/documents/approbation/${n2}/decision",
          "corps": {
            "approuve": true,
            "note": "trop tôt"
          },
          "statut": [
            400,
            403,
            409
          ]
        },
        {
          "appel": "POST /api/documents/approbation/${n1}/decision",
          "corps": {
            "approuve": true,
            "note": "Approvisionnement : conforme"
          },
          "verifier": [
            {
              "chemin": "$.statut",
              "egal": "APPROUVE"
            }
          ]
        },
        {
          "appel": "POST /api/documents/approbation/${n2}/decision",
          "profil": "juriste de Lévis",
          "corps": {
            "approuve": true,
            "note": "Juridique : conforme"
          },
          "verifier": [
            {
              "chemin": "$.approbateur",
              "egal": "juriste@levis.qc.ca"
            }
          ]
        },
        {
          "appel": "POST /api/documents/approbation/${n3}/decision",
          "profil": "direction de Lévis",
          "corps": {
            "approuve": true,
            "note": "Direction : approuvé"
          }
        },
        {
          "appel": "GET /api/documents/${document}/approbation",
          "verifier": [
            {
              "chemin": "$[*].statut",
              "exclut": "EN_ATTENTE"
            }
          ]
        },
        {
          "appel": "GET /api/audit?entite=Document",
          "profil": "administrateur de Lévis",
          "verifier": [
            {
              "chemin": "$[*].action",
              "inclut": "COMMENTER"
            }
          ]
        }
      ]
    },
    "lev.revision.workflow-configurable": {
      "description": "Circuit d'approbation configurable par type de document : un document de ce type suit le circuit configuré, et non le circuit par défaut",

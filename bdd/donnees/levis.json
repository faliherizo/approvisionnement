    "lev.clauses.historique": {
      "description": "Historique par clause : chaque version consultable avec auteur, date et motif ; restauration d'une version antérieure, qui devient une nouvelle version",
      "etapes": [
        {
          "appel": "POST /api/clauses",
          "corps": {
            "code": "HIS-${UNIQUE}",
            "titre": "Historisée ${unique}",
            "categorie": "STANDARD",
            "corps": "Texte initial ${unique}"
          },
          "capturer": {
            "clause": "$.id"
          }
        },
        {
          "appel": "PUT /api/clauses/${clause}",
          "profil": "juriste de Lévis",
          "corps": {
            "code": "HIS-${UNIQUE}",
            "titre": "Historisée ${unique}",
            "categorie": "STANDARD",
            "corps": "Texte révisé ${unique}"
          },
          "verifier": [
            {
              "chemin": "$.version",
              "egal": 2
            }
          ]
        },
        {
          "appel": "GET /api/clauses/${clause}/versions",
          "verifier": [
            {
              "chemin": "$",
              "longueurMin": 2
            },
            {
              "chemin": "$[0].numero",
              "egal": 2
            },
            {
              "chemin": "$[0].auteur",
              "egal": "juriste@levis.qc.ca"
            },
            {
              "chemin": "$[0].motif",
              "egal": "MODIFICATION"
            },
            {
              "chemin": "$[1].auteur",
              "egal": "redacteur@levis.qc.ca"
            },
            {
              "chemin": "$[1].corps",
              "egal": "Texte initial ${unique}"
            },
            {
              "chemin": "$[1].creeLe",
              "existe": true
            }
          ]
        },
        {
          "appel": "POST /api/clauses/${clause}/versions/1/restaurer",
          "verifier": [
            {
              "chemin": "$.corps",
              "egal": "Texte initial ${unique}"
            },
            {
              "chemin": "$.version",
              "egal": 3
            }
          ]
        },
        {
          "appel": "GET /api/clauses/${clause}/versions",
          "verifier": [
            {
              "chemin": "$[0].motif",
              "egal": "RESTAURATION"
            },
            {
              "chemin": "$[0].versionRestauree",
              "egal": 1
            }
          ]
        },
        {
          "appel": "POST /api/clauses/${clause}/versions/9/restaurer",
          "statut": 404,
          "note": "une version inexistante ne se restaure pas"
        },
        {
          "appel": "GET /api/clauses/${clause}/versions",
          "profil": "administration d'affaires IQ",
          "statut": [
            403,
            404
          ],
          "note": "une autre organisation ne voit pas l'historique"
        }
      ]
    },
    "lev.loi25.droits": {
      "description": "Loi 25 : une personne active (compte, journal, clause) obtient tout ce qui est détenu sur elle, puis est effacée ; registre des demandes sous empreinte ; refus de s'effacer soi-même et refus pour un non-administrateur",
      "etapes": [
        {
          "appel": "POST /api/admin/users",
          "corps": {
            "email": "marie.${unique}@levis.qc.ca",
            "nom": "Marie Tremblay ${unique}",
            "motDePasse": "Passw0rd!2026",
            "roles": [
              "REDACTEUR"
            ],
            "actif": true
          }
        },
        {
          "appel": "POST /api/auth/login",
          "anonyme": true,
          "corps": {
            "email": "marie.${unique}@levis.qc.ca",
            "motDePasse": "Passw0rd!2026"
          }
        },
        {
          "appel": "POST /api/loi25/acces",
          "corps": {
            "courriel": "marie.${unique}@levis.qc.ca"
          },
          "verifier": [
            {
              "chemin": "$.courriel",
              "egal": "marie.${unique}@levis.qc.ca"
            },
            {
              "chemin": "$.sources[*].source",
              "inclut": "Compte"
            },
            {
              "chemin": "$.sources[*].source",
              "inclut": "Journal d'audit"
            },
            {
              "texte": "Marie Tremblay ${unique}"
            },
            {
              "texteAbsent": "$2a$"
            }
          ]
        },
        {
          "appel": "POST /api/loi25/effacement",
          "corps": {
            "courriel": "marie.${unique}@levis.qc.ca",
            "motif": "Demande écrite ${unique}"
          },
          "verifier": [
            {
              "chemin": "$[*].source",
              "inclut": "Compte"
            }
          ]
        },
        {
          "appel": "POST /api/auth/login",
          "anonyme": true,
          "corps": {
            "email": "marie.${unique}@levis.qc.ca",
            "motDePasse": "Passw0rd!2026"
          },
          "statut": [
            400,
            401,
            403
          ],
          "note": "le compte effacé ne s'ouvre plus"
        },
        {
          "appel": "POST /api/loi25/acces",
          "corps": {
            "courriel": "marie.${unique}@levis.qc.ca"
          },
          "verifier": [
            {
              "texteAbsent": "Marie Tremblay ${unique}"
            }
          ]
        },
        {
          "appel": "GET /api/loi25/demandes",
          "verifier": [
            {
              "chemin": "$[*].type",
              "inclut": "EFFACEMENT"
            },
            {
              "chemin": "$[*].motif",
              "inclut": "Demande écrite ${unique}"
            },
            {
              "texteAbsent": "marie.${unique}@levis.qc.ca"
            }
          ]
        },
        {
          "appel": "POST /api/loi25/effacement",
          "corps": {
            "courriel": "admin@levis.qc.ca",
            "motif": "essai"
          },
          "statut": 409,
          "note": "on ne s'efface pas soi-même"
        },
        {
          "appel": "POST /api/loi25/acces",
          "profil": "rédacteur de Lévis",
          "corps": {
            "courriel": "admin@levis.qc.ca"
          },
          "statut": 403
        }
      ]
    },
    "lev.seao.export": {
      "description": "Export SEAO : la fiche XML reprend les métadonnées du devis (échappées), l'export est journalisé ; un devis sans numéro d'appel d'offres est refusé",
      "etapes": [
        {
          "appel": "POST /api/documents",

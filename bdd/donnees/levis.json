            ],
            "actif": true
          },
          "capturer": {
            "workflow": "$.id"
          },
          "verifier": [
            {
              "chemin": "$.etapes",
              "egal": [
                "APPRO",
                "DIRECTION"
              ]
            }
          ]
        },
        {
          "appel": "GET /api/workflows",
          "verifier": [
            {
              "chemin": "$[*].nom",
              "inclut": "Circuit bail BDD ${unique}"
            }
          ]
        },
        {
          "appel": "POST /api/documents",
          "corps": {
            "titre": "Bail BDD ${unique}",
            "type": "BAIL"
          },
          "capturer": {
            "document": "$.id"
          }
        },
        {
          "appel": "POST /api/documents/${document}/approbation",
          "corps": {},
          "verifier": [
            {
              "chemin": "$[*].roleRequis",
              "egal": [
                "APPRO",
                "DIRECTION"
              ]
            }
          ]
        },
        {
          "appel": "DELETE /api/workflows/${workflow}"
        }
      ]
    },
    "lev.addendas.integration": {
      "description": "Addenda interactif rattaché à une clause, émis puis intégré au document final (PDF et Word)",
      "etapes": [
        {
          "appel": "POST /api/documents",
          "corps": {
            "titre": "Devis BDD ${unique}",
            "type": "APPEL_OFFRES_PUBLIC",
            "modeSollicitation": "APPEL_OFFRES_PUBLIC",
            "valeurEstimee": 150000
          },
          "capturer": {
            "document": "$.id"
          }
        },
        {
          "appel": "POST /api/documents/${document}/assembler",
          "corps": {
            "clauseIds": []
          },
          "capturer": {
            "clauseDoc": "$.clauses[0].clauseId"
          }
        },
        {
          "appel": "POST /api/documents/${document}/addendas",
          "corps": {
            "objet": "Report de la date d'ouverture ${unique}"
          },
          "capturer": {
            "addenda": "$.id"
          },
          "verifier": [
            {
              "chemin": "$.statut",
              "egal": "BROUILLON"
            },
            {
              "chemin": "$.numero",
              "egal": 1
            }
          ]
        },
        {
          "appel": "POST /api/addendas/${addenda}/changements",
          "corps": {
            "clauseId": "${clauseDoc}",
            "nouveauTexte": "Texte modifié par l'addenda n° 1 ${unique}."
          },
          "verifier": [
            {
              "chemin": "$.changements[0].ancienTexte",
              "existe": true
            }
          ]
        },
        {
          "appel": "POST /api/addendas/${addenda}/reintegrer",
          "verifier": [
            {
              "chemin": "$.statut",
              "egal": "PUBLIE"
            },
            {
              "chemin": "$.emisLe",
              "existe": true
            }
          ]
        },
        {
          "appel": "GET /api/documents/${document}",
          "verifier": [
            {
              "chemin": "$.clauses[*].texteEffectif",
              "inclut": "Texte modifié par l'addenda n° 1 ${unique}."
            }
          ]
        },
        {
          "appel": "GET /api/documents/${document}/export/pdf",
          "entetes": {
            "Accept": "application/pdf"
          },
          "verifier": [
            {
              "texte": "%PDF"
            }
          ]
        },
        {
          "appel": "GET /api/documents/${document}/export/docx",
          "verifier": [
            {
              "texte": "PK"
            }
          ]
        }
      ]
    },
    "lev.normatif.verrouille": {
      "description": "Conformité légale : une clause normative (LCV, Charte de la langue française) est fournie et verrouillée",
      "etapes": [
        {
          "appel": "GET /api/clauses",
          "verifier": [
            {
              "chemin": "$[*].normative",
              "inclut": true
            },
            {
              "chemin": "$[*].code",
              "inclut": "GEN-002"
            }
          ]
        }
      ]
    },
    "lev.securite.roles": {
      "description": "Rôles distincts : un rédacteur n'administre ni les utilisateurs ni le journal",
      "etapes": [
        {
          "appel": "GET /api/admin/users",
          "statut": 403
        },
        {
          "appel": "GET /api/audit",
          "statut": 403
        },

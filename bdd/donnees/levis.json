    "lev.assemblage.adaptation": {
      "description": "Adaptation des clauses au type, au mode, à la valeur et au contexte ; assemblage automatique des clauses standards",
      "etapes": [
        {
          "appel": "POST /api/clauses",
          "corps": {
            "code": "SEUIL-${UNIQUE}",
            "titre": "Garantie de soumission ${unique}",
            "categorie": "OPTIONNELLE",
            "corps": "Garantie de soumission de 10 %.",
            "numero": "8.01",
            "section": "Garanties",
            "conditions": [
              {
                "attribut": "TYPE_CONTRAT",
                "valeur": "APPEL_OFFRES_PUBLIC"
              },
              {
                "attribut": "MODE_SOLLICITATION",
                "valeur": "APPEL_OFFRES_PUBLIC"
              },
              {
                "attribut": "VALEUR_MIN",
                "valeur": "100000"
              },
              {
                "attribut": "CONTEXTE",
                "valeur": "travaux"
              }
            ]
          },
          "statut": [
            200,
            201
          ],
          "capturer": {
            "clauseSeuil": "$.id"
          }
        },
        {
          "appel": "POST /api/documents",
          "corps": {
            "titre": "Devis BDD ${unique}",
            "type": "APPEL_OFFRES_PUBLIC",
            "modeSollicitation": "APPEL_OFFRES_PUBLIC",

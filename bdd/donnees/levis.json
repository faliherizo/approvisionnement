            201
          ]
        },
        {
          "appel": "POST /api/clauses",
          "corps": {
            "code": "EXC-${UNIQUE}",
            "titre": "Dispense d'assurance ${unique}",
            "categorie": "OPTIONNELLE",
            "corps": "Aucune assurance exigée.",
            "numero": "7.02",
            "section": "Assurances"
          },
          "statut": [
            200,
            201
          ],
          "capturer": {
            "exclue": "$.id"
          }
        },
        {
          "appel": "POST /api/clauses",
          "corps": {
            "code": "PRI-${UNIQUE}",
            "titre": "Travaux en hauteur ${unique}",
            "categorie": "OPTIONNELLE",
            "corps": "Travaux en hauteur encadrés.",
            "numero": "7.03",
            "section": "Sécurité",
            "dependances": [
              "REQ-${UNIQUE}"
            ],
            "exclusions": [
              "EXC-${UNIQUE}"
            ]
          },
          "statut": [
            200,
            201
          ],
          "capturer": {
            "principale": "$.id"
          }
        },
        {
          "appel": "POST /api/documents",
          "corps": {
            "titre": "Devis BDD ${unique}",

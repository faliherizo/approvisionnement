            {
              "chemin": "$[*].code",
              "exclut": "SEUIL-${UNIQUE}"
            }
          ]
        },
        {
          "appel": "POST /api/documents/${document}/assembler",
          "corps": {
            "clauseIds": []
          },
          "verifier": [
            {
              "chemin": "$.clauses",
              "longueurMin": 1
            },
            {
              "chemin": "$.clauses[*].code",
              "inclut": "GEN-001"

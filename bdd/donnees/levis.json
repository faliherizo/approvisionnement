  "cas": {
    "lev.clauses.bibliotheque": {
      "description": "Bibliothèque centralisée : une clause de chaque catégorie, modifiée puis retrouvée par recherche, puis archivée",
      "etapes": [
        {
          "appel": "POST /api/clauses",
          "corps": {
            "code": "STD-${UNIQUE}",
            "titre": "Délai d'exécution ${unique}",
            "categorie": "STANDARD",
            "corps": "Les travaux sont exécutés dans les délais du devis.",
            "numero": "9.10",
            "section": "Exécution"
          },
          "statut": [
            200,
            201
          ],
          "capturer": {
            "standard": "$.id"
          },
          "verifier": [
            {
              "chemin": "$.categorie",
              "egal": "STANDARD"
            },
            {
              "chemin": "$.version",
              "egal": 1
            }
          ]
        },
        {
          "appel": "POST /api/clauses",
          "corps": {
            "code": "OPT-${UNIQUE}",
            "titre": "Garantie prolongée ${unique}",
            "categorie": "OPTIONNELLE",
            "corps": "Garantie de 24 mois.",
            "numero": "9.11",
            "section": "Garanties"
          },
          "statut": [
            200,
            201
          ],
          "capturer": {
            "optionnelle": "$.id"
          },
          "verifier": [
            {
              "chemin": "$.categorie",
              "egal": "OPTIONNELLE"
            }
          ]
        },
        {
          "appel": "POST /api/clauses",
          "corps": {
            "code": "PER-${UNIQUE}",
            "titre": "Clause propre au projet ${unique}",
            "categorie": "PERSONNALISEE",
            "corps": "Exigence propre au site.",
            "numero": "9.12",
            "section": "Particularités"
          },
          "statut": [
            200,
            201
          ],
          "verifier": [
            {
              "chemin": "$.categorie",
              "egal": "PERSONNALISEE"
            }
          ]
        },
        {
          "appel": "PUT /api/clauses/${standard}",
          "corps": {
            "code": "STD-${UNIQUE}",
            "titre": "Délai d'exécution ${unique}",
            "categorie": "STANDARD",
            "corps": "Les travaux sont exécutés dans les 60 jours.",
            "numero": "9.10",
            "section": "Exécution"
          },
          "verifier": [
            {
              "chemin": "$.corps",
              "contient": "60 jours"
            },
            {
              "chemin": "$.version",
              "egal": 2
            }
          ]
        },
        {
          "appel": "GET /api/clauses/recherche?q=${unique}&page=0&taille=20",
          "verifier": [
            {
              "chemin": "$.contenu[*].code",
              "inclut": "STD-${UNIQUE}"
            },
            {
              "chemin": "$.contenu[*].code",
              "inclut": "OPT-${UNIQUE}"
            }
          ]
        },
        {
          "appel": "DELETE /api/clauses/${optionnelle}",
          "profil": "administrateur de Lévis"
        },
        {
          "appel": "GET /api/clauses",
          "verifier": [
            {
              "chemin": "$[*].code",
              "exclut": "OPT-${UNIQUE}"
            },
            {
              "chemin": "$[*].code",
              "inclut": "STD-${UNIQUE}"
            }
          ]
        }
      ]
    },
    "lev.clauses.recherche-multicritere": {
      "description": "Recherche multicritère : terme, portée (catégorie), thématique (section), type de contrat, clauses normatives",
      "etapes": [
        {
          "appel": "GET /api/search?q=contrat&categorie=STANDARD",
          "verifier": [
            {
              "chemin": "$.clauses",
              "longueurMin": 1
            },
            {
              "chemin": "$.clauses[*].categorie",
              "exclut": "OPTIONNELLE"
            }
          ]
        },
        {
          "appel": "GET /api/search?q=Objet&type=APPEL_OFFRES_PUBLIC",
          "verifier": [
            {
              "chemin": "$.terme",
              "egal": "Objet"
            }
          ]
        },
        {
          "appel": "GET /api/search/thematiques",
          "verifier": [
            {
              "chemin": "$",
              "contient": "Dispositions générales"
            }
          ]
        },
        {
          "appel": "GET /api/search?q=&thematique=dispositions%20g%C3%A9n%C3%A9rales",
          "verifier": [
            {
              "chemin": "$.clauses",
              "longueurMin": 1
            },
            {
              "chemin": "$.facettesThematique.Dispositions générales",
              "existe": true
            }
          ]
        },
        {
          "appel": "GET /api/search?q=&normative=true",
          "verifier": [
            {
              "chemin": "$.clauses",
              "longueurMin": 1
            },
            {
              "chemin": "$.clauses[*].normative",
              "exclut": false
            }
          ]
        }
      ]
    },

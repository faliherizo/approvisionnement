                    {
                      "cle": "demandeur",
                      "libelle": "Demandeur",
                      "type": "TEXTE",
                      "obligatoire": true,
                      "source": "Demandeur"
                    },
                    {
                      "cle": "montant",
                      "libelle": "Montant",
                      "type": "TEXTE",
                      "obligatoire": true,
                      "source": "Montant",
                      "format": "\\d+(\\.\\d{2})?"
                    },
                    {
                      "cle": "programme",
                      "libelle": "Programme",
                      "type": "LISTE",
                      "options": [
                        "ESSOR",
                        "IMPULSION"
                      ]
                    },
                    {
                      "cle": "debut",
                      "libelle": "Date de début",
                      "type": "DATE"
                    },
                    {
                      "cle": "garantie",
                      "libelle": "Garantie exigée",
                      "type": "CASE"
                    },
                    {
                      "cle": "signature1",
                      "libelle": "Signature du bénéficiaire",
                      "type": "SIGNATURE",
                      "roleDestinataire": "SIGNATAIRE_1",
                      "position": {
                        "page": 1,
                        "x": 10,
                        "y": 75,
                        "largeur": 40,
                        "hauteur": 10
                      }
                    }
                  ],
                  "clauses": [
                    {
                      "cle": "garantie",
                      "titre": "Garantie",
                      "texte": "Le bénéficiaire fournit une garantie de prêt.",
                      "combinateur": "ET",
                      "conditions": [
                        {
                          "champ": "garantie",
                          "operateur": "EGAL",
                          "valeur": "true"
                        }
                      ]
                    }
                  ],
                  "parcours": [
                    {
                      "cle": "v1",
                      "libelle": "Validation juridique",

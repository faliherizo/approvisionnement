      "exigences": [
        "CHU-3.03",
        "CHU-3.09",
        "CHU-4.01"
      ],
      "profil": "administrateur CHU",
      "organisation": "CHU",
      "etapes": [
        {
          "preparer": {
            "description": "Formulaire publié en deux versions, et un brouillon à supprimer",
            "etapes": [
              {
                "appel": "POST /api/formulaires",
                "corps": {
                  "code": "VERS_${UNIQUE}",
                  "nom": "VERS ${unique}",
                  "domaine": "RH",
                  "conservationJours": 365
                },
                "capturer": {
                  "formulaire": "$.id"
                }
              },
              {
                "appel": "PUT /api/formulaires/${formulaire}/structure",
                "corps": {
                  "structureJson": "{\"pages\": [{\"titre\": \"Identité\", \"champs\": [{\"cle\": \"nom\", \"libelle\": \"Nom\", \"type\": \"TEXTE\", \"obligatoire\": true}]}]}"
                }
              },
              {
                "appel": "POST /api/formulaires/${formulaire}/soumettre"
              },
              {
                "appel": "POST /api/formulaires/${formulaire}/publier"
              },
              {
                "appel": "PUT /api/formulaires/${formulaire}/structure",
                "corps": {
                  "structureJson": "{\"pages\": [{\"titre\": \"Identité\", \"champs\": [{\"cle\": \"nom\", \"libelle\": \"Nom complet\", \"type\": \"TEXTE\", \"obligatoire\": true}]}]}"
                }
              },
              {
                "appel": "POST /api/formulaires/${formulaire}/soumettre"
              },
              {
                "appel": "POST /api/formulaires/${formulaire}/publier"
              },
              {
                "appel": "POST /api/formulaires",
                "corps": {
                  "code": "SUPPR_${UNIQUE}",
                  "nom": "SUPPR ${unique}",
                  "domaine": "RH",
                  "conservationJours": 365
                }
              }
            ]

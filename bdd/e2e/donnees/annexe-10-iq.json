    {
      "id": "E2E-AX-IQ-07",
      "titre": "TI-04 (RST-46) : l'administration technique crée un client SIEM ; Microsoft Sentinel lit le journal d'audit par curseur (ASIM, CEF) avec son jeton, sans session, et ne peut rien d'autre",
      "exigences": [
        "IQ-D-19"
      ],
      "profil": "administration technique IQ",
      "etapes": [
        {
          "aller": "/clm/admin/integrations"
        },
        {
          "remplir": {
            "Nouveau client d’intégration » Nom": "Sentinel E2E ${unique}"
          }
        },
        {
          "choisir": {
            "Nouveau client d’intégration » Système": "SIEM (Microsoft Sentinel) — lecture du journal seulement"
          }
        },
        {
          "voir": "ne déclenche aucune signature"
        },
        {
          "cliquer": "Créer le client"
        },
        {
          "voir": "Client « Sentinel E2E ${unique} » créé."
        },
        {
          "lire": {
            "selecteur": ".clm-info-statique .clm-dl div:nth-child(1) code",
            "variable": "clientId"
          }
        },
        {
          "lire": {
            "selecteur": ".clm-info-statique .clm-dl div:nth-child(2) code",
            "variable": "secret"
          }
        },
        {
          "preparer": {
            "description": "Le SIEM obtient un jeton (client credentials) puis lit le journal page par page ; il ne crée aucune trousse",
            "etapes": [
              {
                "appel": "POST /api/clm/integration/oauth/token",
                "anonyme": true,
                "formulaire": {
                  "grant_type": "client_credentials",
                  "client_id": "${clientId}",
                  "client_secret": "${secret}"
                },
                "capturer": {
                  "jeton": "$.access_token"
                }
              },
              {
                "appel": "GET /api/clm/integration/v1/journal?apres=0&limite=50",
                "anonyme": true,
                "entetes": {
                  "Authorization": "Bearer ${jeton}"
                },
                "capturer": {
                  "curseur": "$.curseurSuivant"
                },
                "verifier": [
                  {
                    "chemin": "$.evenements[0].EventVendor",
                    "egalTexte": "Vina"
                  },
                  {
                    "chemin": "$.evenements[0].EventSchema",
                    "egalTexte": "AuditEvent"
                  },
                  {
                    "texte": "CEF:0|Vina|CLM|1.0|"
                  }
                ]
              },
              {
                "appel": "GET /api/clm/integration/v1/journal?apres=${curseur}&limite=50",
                "anonyme": true,
                "entetes": {
                  "Authorization": "Bearer ${jeton}"
                }
              },
              {
                "appel": "POST /api/clm/integration/v1/trousses",
                "anonyme": true,
                "entetes": {
                  "Authorization": "Bearer ${jeton}"
                },
                "corps": {},
                "statut": 403
              }
            ]
          }
        },
        {
          "cliquer": "J’ai copié les valeurs"
        },
        {
          "voir": "Sentinel E2E ${unique}"
        },
        {
          "ecranConforme": true
        }
      ]
    }
  ]

        {
          "voir": [
            "Clé de l’organisation",
            "Clé maîtresse active",
            "Active"
          ]
        },
        {
          "cliquer": "Pivoter la clé"
        },
        {
          "voir": "Rotation effectuée"
        },
        {
          "voir": "Retirée (lecture seule)"
        },
        {
          "preparer": {
            "description": "Après la rotation, le document chiffré par l'ancienne version reste lisible",

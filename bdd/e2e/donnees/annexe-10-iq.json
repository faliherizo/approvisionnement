    {
      "id": "E2E-AX-IQ-25",
      "titre": "SEC-28 (RST-54) : les documents d'IQ sont chiffrés par une clé dédiée à l'organisation ; l'administration technique pivote la clé sans interruption puis réenveloppe les documents, qui restent lisibles",
      "exigences": [
        "IQ-C-07",
        "IQ-D-20"
      ],
      "profil": "administration technique IQ",
      "etapes": [
        {
          "preparer": {
            "description": "Un document déposé par l'initiateur : la première écriture crée la clé de données de l'organisation",
            "etapes": [
              {
                "appel": "POST /api/clm/trousses",
                "profil": "initiateur IQ",
                "corps": {
                  "titre": "Chiffrement ${unique}",
                  "risque": "FAIBLE"
                },
                "capturer": {
                  "trousse": "$.resume.id"
                }
              },
              {
                "appel": "POST /api/clm/trousses/${trousse}/documents",
                "profil": "initiateur IQ",
                "multipart": {
                  "fichier": {
                    "fichier": "pdf",
                    "nom": "chiffre-${unique}.pdf",
                    "type": "application/pdf"
                  }
                },
                "capturer": {
                  "document": "$.id"
                }
              }
            ]
          }
        },
        {
          "aller": "/clm/admin/chiffrement"

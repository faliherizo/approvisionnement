    {
      "id": "E2E-AX-IQ-03",
      "titre": "SEC-17 (RST-44) : l'administration d'affaires d'IQ accorde un accès de soutien à l'exploitant, voit sa consultation au journal de la trousse, puis le révoque ; sans accès, l'exploitant ne lit rien",
      "exigences": [
        "IQ-D-16",
        "IQ-A-26"
      ],
      "profil": "administration d'affaires IQ",
      "etapes": [
        {
          "preparer": {
            "description": "Une trousse d'IQ, et une demande d'accès de soutien de l'exploitant, refusée tant qu'elle n'est pas accordée",
            "etapes": [
              {
                "appel": "POST /api/clm/trousses",
                "profil": "initiateur IQ",
                "corps": {
                  "titre": "Soutien ${unique}",
                  "risque": "FAIBLE"
                },
                "capturer": {
                  "trousse": "$.resume.id",
                  "reference": "$.resume.reference"
                }
              },
              {
                "appel": "GET /api/superadmin/tenants",
                "profil": "superadmin",
                "capturer": {
                  "iq": "$[?slug=iq].id"
                }
              },
              {
                "appel": "GET /api/clm/trousses/${trousse}",
                "profil": "superadmin",
                "statut": 403,
                "note": "l'exploitant ne lit aucune trousse"
              },
              {
                "appel": "POST /api/superadmin/tenants/${iq}/soutien-clm/demandes",
                "profil": "superadmin",
                "corps": {
                  "motif": "Billet E2E ${unique}",
                  "dureeHeures": 2
                },
                "statut": 201
              },
              {
                "appel": "GET /api/superadmin/tenants/${iq}/soutien-clm/trousses/${reference}",
                "profil": "superadmin",
                "statut": 403,
                "note": "demandé n'est pas accordé"
              }
            ]
          }
        },
        {
          "aller": "/clm/admin/soutien"
        },
        {
          "voirTitre": "Accès de soutien de l’exploitant"
        },
        {
          "voir": "Billet E2E ${unique}"
        },
        {
          "cliquer": "Accorder l’accès à superadmin@plateforme.ca"
        },
        {
          "voir": "Accès accordé à superadmin@plateforme.ca."
        },
        {
          "preparer": {
            "description": "Pendant l'accès accordé, l'exploitant consulte le diagnostic de la trousse, sans son contenu",
            "etapes": [
              {
                "appel": "GET /api/superadmin/tenants/${iq}/soutien-clm/trousses/${reference}",
                "profil": "superadmin",
                "verifier": [
                  {
                    "chemin": "$.reference",
                    "egalTexte": "${reference}"
                  },
                  {
                    "texteAbsent": "Soutien ${unique}"
                  }
                ]
              }
            ]
          }
        },
        {
          "aller": "/clm/trousses/${trousse}"
        },
        {
          "cliquer": {
            "role": "tab",
            "nom": "Historique"
          }
        },
        {
          "voir": [
            "Consultation de soutien de l’exploitant",
            "Billet E2E ${unique}"
          ]
        },
        {
          "aller": "/clm/admin/soutien"
        },
        {
          "ecranConforme": true
        },
        {
          "cliquer": "Révoquer l’accès de superadmin@plateforme.ca"
        },
        {
          "voir": "Accès de superadmin@plateforme.ca révoqué."
        },
        {
          "preparer": {
            "description": "Révoqué : l'exploitant ne lit plus rien",
            "etapes": [
              {
                "appel": "GET /api/superadmin/tenants/${iq}/soutien-clm/trousses/${reference}",
                "profil": "superadmin",
                "statut": 403
              }
            ]
          }
        }
      ]
    },

                "appel": "GET /api/clm/trousses/${trousse}/documents/${document}/contenu",
                "profil": "initiateur IQ",
                "verifier": [
                  {
                    "texte": "%PDF"
                  }
                ]
              }
            ]
          }
        },
        {
